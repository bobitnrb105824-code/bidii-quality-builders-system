rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: estimates
    // Fields: projectName (string), clientName (string), visitDate (string), status (string), estimatedCost (number), createdAt (timestamp)
    //
    // Collection: jobs
    // Fields: title (string), clientName (string), startDate (string), endDate (string), status (string), budget (number), progress (number)
    //
    // Collection: materials
    // Fields: itemName (string), supplier (string), quantity (number), unit (string), status (string), orderDate (string)
    //
    // Collection: suppliers
    // Fields: name (string), email (string), phone (string), category (string), status (string)
    //
    // Collection: invoices
    // Fields: invoiceNumber (string), clientName (string), projectName (string), amount (number), dueDate (string), status (string)
    //
    // Collection: workers
    // Fields: name (string), trade (string), phone (string), status (string), photoUrl (string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "bobitnrb105824@spu.ac.ke" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidStatus(status, allowed) {
      return status in allowed;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /estimates/{estimateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['projectName', 'clientName', 'status']);
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['title', 'status']);
      allow delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['itemName', 'supplier', 'status']);
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['name', 'status']);
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['invoiceNumber', 'amount', 'status']);
      allow delete: if isAdmin();
    }

    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && hasRequiredFields(['name', 'trade', 'status']);
      allow delete: if isAdmin();
    }
  }
}
